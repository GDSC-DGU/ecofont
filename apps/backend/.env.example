GCS_INPUT_BUCKET=ecofont-input
GCS_OUTPUT_BUCKET=ecofont-output
SIGNED_URL_TTL_SECONDS=86400
MAX_FILE_SIZE_BYTES=10485760
PORT=8080
LOG_LEVEL=INFO

# CORS — 콤마 구분. 프론트 배포 도메인 추가. 정규식은 Vercel preview 대응.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://ecofont.vercel.app
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# 로컬 개발 시에만 사용 (Cloud Run은 IAM SA 자동)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
